# Пароль администратора (обязателен, иначе админка недоступна)
ADMIN_PASSWORD=

# Необязательно: отдельный секрет для подписи куки сессии.
# Если не задан, подпись делается на основе ADMIN_PASSWORD.
ADMIN_SECRET=

# --- Хранилище: выберите ОДИН вариант ---
# 1) MySQL / MariaDB (прод на Zone; таблица tunniplaan_weeks создаётся сама)
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# MYSQL_PORT=3306

# 2) Ничего не задано — недели пишутся в папку .data/ (только для локального запуска)

# --- Tahvel (всё необязательно, значения по умолчанию — для TARpv24) ---
# Секрет суточного крона: zone/cron.sh шлёт его в заголовке Authorization.
CRON_SECRET=

# Код группы; uuid находится сам, если группа есть в расписании ближайших трёх недель
# TAHVEL_GROUP=TARpv24
# TAHVEL_GROUP_UUID=

# Сколько недель вперёд обновляет крон (по умолчанию 3)
# TAHVEL_WEEKS_AHEAD=3

# --- EduPage (запасной источник; всё необязательно) ---
# Поддомен школы: https://<EDUPAGE_SCHOOL>.edupage.org
# EDUPAGE_SCHOOL=mustamae-techno
# Либо адрес целиком, если он нестандартный
# EDUPAGE_BASE_URL=

# --- Порядок источников ---
# Перебираются слева направо, к следующему переходим, только если предыдущий
# не дал за неделю ни одного занятия. По умолчанию: tahvel,edupage
# SCHEDULE_SOURCES=tahvel,edupage

# --- Встраивание ---
# Сайты, которым можно показывать /embed во фрейме (через пробел).
# По умолчанию: https://maksimtsikvasvili24.thkit.ee
# EMBED_ORIGINS=https://maksimtsikvasvili24.thkit.ee
